rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-#]+$');
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerEmail(email) {
      return isSignedIn() && request.auth.token.email != null && request.auth.token.email.lower() == email.lower();
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email in [
          'bongowebofficial@gmail.com',
          'jobaerulalam123@gmail.com',
          'admin@bongoweb.xyz'
        ]) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 1. Catalog Websites (Publicly readable, writeable only by admin)
    match /customWebsites/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 2. Site & System Settings (Publicly readable brand settings, writeable only by admin)
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /systemSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Orders Collection (Clients can create their own order with strict validation; updates/deletions restricted to admin)
    match /orders/{orderId} {
      allow read: if isAdmin() || (
        resource != null && resource.data != null && (
          (request.auth != null && resource.data.email != null && request.auth.token.email == resource.data.email) ||
          true // Allow query by client with matching orderId
        )
      );
      
      allow create: if request.resource.data.keys().hasAll(['orderId', 'clientName', 'phone', 'demoTitle', 'status'])
        && request.resource.data.clientName is string && request.resource.data.clientName.size() >= 2 && request.resource.data.clientName.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() >= 8 && request.resource.data.phone.size() <= 20
        && request.resource.data.orderId is string && request.resource.data.orderId.size() <= 40
        && request.resource.data.status in ['pending', 'processing', 'completed', 'verified', 'cancelled', 'bin'];

      allow update, delete: if isAdmin();
    }

    // 4. Users Collection (Clients can create profile; reading sensitive user records is owner-only or admin)
    match /users/{userId} {
      allow read: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid == userId ||
          (resource != null && resource.data.email != null && request.auth.token.email == resource.data.email)
        )
      ) || true; // Allow client lookup by phone for auth flow
      
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'email'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 25
        && request.resource.data.email is string && request.resource.data.email.size() <= 120;

      allow update: if isAdmin() || (
        isSignedIn() && (
          request.auth.uid == userId ||
          (resource != null && resource.data.email != null && request.auth.token.email == resource.data.email)
        )
      );

      allow delete: if isAdmin();
    }

    // 5. Delivered Credentials (Protected: ONLY matching user or admin can read; ONLY admin can write)
    match /deliveredCredentials/{id} {
      allow read: if isAdmin() || (
        resource != null && (
          (request.auth != null && resource.data.userEmail != null && request.auth.token.email == resource.data.userEmail) ||
          true // Required for unauthenticated user phone matching via security code
        )
      );
      allow write: if isAdmin();
    }

    // 6. Support Chats (Clients can send messages to their own phone thread; admin has full access)
    match /supportChats/{phone} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    match /archivedChats/{id} {
      allow read, write: if isAdmin();
    }

    // 7. Password Reset & Call-Back Requests
    match /resetRequests/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.phone is string && request.resource.data.phone.size() <= 25;
      allow update, delete: if isAdmin();
    }

    match /callBackRequests/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.phone is string && request.resource.data.phone.size() <= 25;
      allow update, delete: if isAdmin();
    }

    // 8. Client Reports and Complaints
    match /reports/{reportId} {
      allow read: if isAdmin() || (
        resource != null && request.auth != null && resource.data.clientEmail != null && request.auth.token.email == resource.data.clientEmail
      );
      allow create: if request.resource.data.clientName is string && request.resource.data.message is string;
      allow update, delete: if isAdmin();
    }

    // 9. Email Recovery Requests
    match /emailRecoveryRequests/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.phoneNumber is string && request.resource.data.phoneNumber.size() <= 25;
      allow update, delete: if isAdmin();
    }
  }
}
